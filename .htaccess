RewriteEngine On

# Heikle Dot-Ordner direkt blocken, bevor andere Rewrite-Regeln greifen
RewriteRule "(^|/)\.(git|ssh|vscode)(/|$)" - [F,L,NC]

# HTTPS erzwingen (funktioniert sowohl nativ als auch hinter nginx-Proxy)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# non-www -> www
RewriteCond %{HTTP_HOST} ^0nefinity\.love$ [NC]
RewriteRule ^ https://www.0nefinity.love%{REQUEST_URI} [R=301,L]

# Spezifische URL-Weiterleitungen (case-sensitive fixes)
RewriteCond %{REQUEST_URI} !^/buyPi$
RewriteRule ^buypi$ https://%{HTTP_HOST}/buyPi [R=302,L,NC]
RewriteRule ^readme/?$ https://%{HTTP_HOST}/README [R=302,L]

# Pi-Quadrat Weiterleitung
RewriteRule ^piquadrat/?$ https://%{HTTP_HOST}/kreisausdingen?anzahl=4&radius=53&zoom=1.00&panX=0.00&panY=0.00&zeichen=pi(30) [R=302,L]

# Textartige Dateien durch PHP-Viewer anzeigen
# Auch Dateien ohne Endung oder mit weirden Text-Endungen; Web-/Script-/Binärdateien bleiben direkt auslieferbar.
# NICHT bei fetch/XHR-Requests oder ?raw=1 (für JavaScript-Apps, die den rohen Text brauchen)
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{HTTP:X-Requested-With} !XMLHttpRequest
RewriteCond %{HTTP:Accept} !application/json
RewriteCond %{QUERY_STRING} !(^|&)raw=1(&|$)
RewriteCond %{REQUEST_FILENAME} !\.(php[0-9]?|phtml|phar|html?|hmtl|shtml?|js|mjs|cjs|css|json|xml|svg|png|jpe?g|gif|webp|bmp|ico|avif|pdf|map|wasm|zip|gz|tar|7z|rar|mp3|mp4|m4a|ogg|wav|flac|mov|webm|ttf|otf|woff2?)$ [NC]
RewriteRule ^(.+)$ /tools/weird-text-viewer.php?path=$1 [L,QSA,B]

# Clean URLs: Redirect .html Endungen zu URLs ohne Endung
# WICHTIG: Query-String mit [QSA] Flag erhalten!
# Explizites https:// weil Apache hinter Reverse Proxy das Schema nicht kennt
RewriteCond %{THE_REQUEST} ^GET\ /(.+)\.html(\?.*)?\ HTTP
RewriteRule ^(.+)\.html$ https://%{HTTP_HOST}/$1 [R=302,L,QSA]

# Intern auf .html Dateien routen (wenn vorhanden)
# QSA: Query-String erhalten!
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# Intern auf .md Dateien routen (wenn vorhanden)
# QSA: Query-String erhalten!
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.md -f
RewriteRule ^(.+)$ $1.md [L,QSA]

# --- Color routes ---
# If the request is exactly one path segment (e.g. /black, /%23ff00aa) and it
# does not map to an existing file/dir or .html/.md, let tools/color.php decide.
# tools/color.php will return 200 for valid colors and 404 for invalid tokens.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.
RewriteRule ^([^/]+)/?$ /tools/color.php?c=$1 [L,QSA]

# Offenes Directory Listing (bewusst)
Options +Indexes +IncludesNOEXEC
AddOutputFilter INCLUDES .html
IndexOptions FancyIndexing NameWidth=* FoldersFirst
IndexOrderDefault Ascending Name
IndexIgnore .git .ssh .vscode .htaccess .htpasswd .env .env.* .gitignore .gitattributes .gitmodules

# Test: SSI gezielt auch für genau eine .html-Datei erlauben
<Files "ssi-test-html.html">
  SetOutputFilter INCLUDES
</Files>

# Nur wirklich heikle Dotfiles sperren; Stil-Dotfiles wie .dot oder .punkt bleiben erlaubt
<FilesMatch "^\.((htaccess|htpasswd)|(env(\..*)?)|(gitignore|gitattributes|gitmodules))$">
  Require all denied
</FilesMatch>

# Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache-Control. Vorher gab es keins - nur ein ETag. Der Browser laedt die
# Dateien dann zwar nicht neu, fragt aber auf JEDER Seite nach, ob sie sich
# geaendert haben. Bei meta.js, das auf 89 Seiten drei weitere Skripte
# nachzieht, sind das vier Rueckfragen pro Seitenaufruf fuer Dateien, die sich
# seit Wochen nicht geaendert haben.
#
# Bewusst gestaffelt, weil "Dateien bearbeiten -> sofort live" laut CLAUDE.md
# ein Feature dieses Projekts ist:
#   Schriften  ein Jahr  - 15949 Dateien, namensversioniert, aendern sich nie
#   Skripte/CSS 5 Minuten - killt die Rueckfragen innerhalb eines Besuchs,
#                           eine Aenderung ist trotzdem nach 5 Minuten draussen
#   HTML/PHP    gar nichts - bleibt sofort live
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpe?g|gif|svg|webp|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

# Security: Content Security Policy. Alles same-origin. Blockt extern Fonts/CDN/Tracker
# als Regression-Guard nach Selfhosting-Cleanup.
# 'unsafe-inline'/'unsafe-eval' nötig wegen vorhandenem Inline-Code (Skripte/Styles)
# und Libraries wie p5/pixi die Function() nutzen.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>