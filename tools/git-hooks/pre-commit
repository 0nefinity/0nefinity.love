#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Regenerate menu + search index when a page is staged. Page content feeds the
# index, so html/md/txt (and extensionless pages) count, not only .html.
# The two generated files themselves do not trigger it; regeneration is
# idempotent, so it also overwrites a stale hand-staged copy.
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
if echo "$staged" | grep -vE '^includes/(something-in-the-body\.html|search-index\.json)$' \
     | grep -qE '(\.(html|md|txt)$|(^|/)[^./]+$)'; then
  python3 tools/generate-menu.py
  git add includes/something-in-the-body.html includes/search-index.json
fi

# Code bundle for 1c0de.html ("whole project"): own code as one text file.
# Generated files under includes/ do not trigger it (no self-trigger); the generator is idempotent.
if echo "$staged" | grep -vE '^includes/' | grep -qE '\.(html|js|css|php|json|md)$'; then
  python3 tools/generate-code-bundle.py
  git add includes/code-bundle.txt
fi

# Autofill: no password/login heuristics on non-login fields (tests/autofill/)
python3 tests/autofill/static-check.py
